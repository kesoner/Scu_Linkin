# Copy to .env on the production server. Never commit the real values.
LINKIN_ADMIN_PASSWORD=replace-with-a-long-unique-password
LINKIN_AUTH_SECRET=replace-with-a-long-random-secret

# LINE Messaging API (copy the real values only to web/.env.local or the
# production server's environment settings; never commit them).
LINE_CHANNEL_ID=replace-with-your-line-channel-id
LINE_CHANNEL_SECRET=replace-with-your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=replace-with-your-line-long-lived-access-token
